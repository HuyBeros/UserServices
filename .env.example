# ====================================
# Environment Variables Configuration
# ====================================
# Copy file này thành .env và điền giá trị thực
# File .env đã được thêm vào .gitignore, KHÔNG bị push lên GitHub

# Server Port
SERVER_PORT=8081

# Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_NAME=QLBookStore
DB_USERNAME=postgres
DB_PASSWORD=CHANGE_THIS_PASSWORD

# JWT Configuration
# Tạo secret key mới (Base64, >= 256 bits): openssl rand -base64 32
# Hoặc PowerShell: [Convert]::ToBase64String((1..32 | ForEach-Object { Get-Random -Minimum 0 -Maximum 256 }))
JWT_SECRET=CHANGE_THIS_IN_PRODUCTION_USE_ENV_VAR
JWT_EXPIRATION=86400000
JWT_REFRESH_EXPIRATION=604800000

# Admin Default Account
ADMIN_USERNAME=admin
ADMIN_PASSWORD=CHANGE_THIS_ADMIN_PASSWORD
ADMIN_EMAIL=admin@bookstore.com
